generator client {
  provider = "prisma-client-js"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

// ─── Student ──────────────────────────────────────────────────────────────────

model Student {
  id                Int      @id @default(autoincrement())
  firstName         String
  lastName          String
  fatherName        String
  motherName        String
  fatherPhoneNumber String
  motherPhoneNumber String
  year              String
  classGroup        String
  location          String?
  status            Status   @default(IN)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  records              DisciplineRecord[]
  transportAssignments TransportAssignment[]
  parentNotifications  ParentNotification[]
  phoneBorrows         PhoneBorrow[]
  termAttendances      TermAttendance[]
}

// ─── Staff ────────────────────────────────────────────────────────────────────

model Staff {
  id          Int       @id @default(autoincrement())
  firstName   String
  lastName    String
  email       String    @unique
  password    String
  phoneNumber String
  role        StaffRole @default(DISCIPLINE)
  permissions String[]  @default([])
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  termAttendances TermAttendance[]
}

enum StaffRole {
  ADMIN
  DISCIPLINE
  NURSE
  LIBRARIAN
}

// ─── Discipline Records ───────────────────────────────────────────────────────

model DisciplineRecord {
  id            Int       @id @default(autoincrement())
  studentId     Int
  reason        String
  location      String?
  status        String    @default("OUT")
  outDate       DateTime  @default(now())
  returnDate    DateTime?
  accompaniedBy String?
  eventTheme    String?
  updatedAt     DateTime  @updatedAt

  student Student @relation(fields: [studentId], references: [id])
}

// ─── Transport ────────────────────────────────────────────────────────────────

model Transport {
  id          Int                   @id @default(autoincrement())
  location    String
  price       Float
  assignments TransportAssignment[]
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
}

model TransportAssignment {
  id          Int             @id @default(autoincrement())
  studentId   Int
  transportId Int
  status      TransportStatus @default(NOT_PAID)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  student   Student   @relation(fields: [studentId], references: [id])
  transport Transport @relation(fields: [transportId], references: [id])

  @@unique([studentId, transportId])
}

enum TransportStatus {
  PAID
  NOT_PAID
  OUT
}

enum Status {
  IN
  OUT
  RETURNED
}

// ─── Phone Borrowing ──────────────────────────────────────────────────────────

model PhoneBorrow {
  id         Int               @id @default(autoincrement())
  studentId  Int
  phoneModel String            @default("Mara Z")
  borrowedAt DateTime          @default(now())
  returnedAt DateTime?
  status     PhoneBorrowStatus @default(BORROWED)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  student Student @relation(fields: [studentId], references: [id])
}

enum PhoneBorrowStatus {
  BORROWED
  RETURNED
}

// ─── Term Sessions & Opening Attendance ──────────────────────────────────────

model TermSession {
  id          Int        @id @default(autoincrement())
  name        String
  year        Int
  startDate   DateTime
  endDate     DateTime
  openingDate DateTime
  isActive    Boolean    @default(false)
  status      TermStatus @default(UPCOMING)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  attendances TermAttendance[]

  @@unique([name, year])
}

model TermAttendance {
  id           Int                  @id @default(autoincrement())
  termId       Int
  studentId    Int
  status       TermAttendanceStatus @default(NOT_REPORTED)
  arrivalTime  DateTime?
  recordedById Int?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  recordedBy Staff?      @relation(fields: [recordedById], references: [id])
  student    Student     @relation(fields: [studentId], references: [id])
  term       TermSession @relation(fields: [termId], references: [id])

  @@unique([termId, studentId])
}

enum TermAttendanceStatus {
  REPORTED
  NOT_REPORTED
}

enum TermStatus {
  UPCOMING
  ACTIVE
  COMPLETED
}

// ─── Parent Notifications ─────────────────────────────────────────────────────

model ParentNotification {
  id        Int                    @id @default(autoincrement())
  studentId Int
  channel   String                 @default("SMS")
  phone     String
  message   String
  type      ParentNotificationType
  status    NotificationStatus     @default(SENT)
  sentAt    DateTime               @default(now())
  createdAt DateTime               @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

enum ParentNotificationType {
  TERM_OPENING
  ABSENCE_ALERT
  ATTENDANCE_SUMMARY
}

enum NotificationStatus {
  SENT
  FAILED
  PENDING
}
