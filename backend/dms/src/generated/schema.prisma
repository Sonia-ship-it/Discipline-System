generator client {
  provider = "prisma-client-js"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

model Student {
  id                Int    @id @default(autoincrement())
  firstName         String
  lastName          String
  fatherName        String
  motherName        String
  fatherPhoneNumber String
  motherPhoneNumber String

  year       String
  classGroup String

  location String? // transport location

  status Status @default(IN)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  records              DisciplineRecord[]
  transportAssignments TransportAssignment[]
  attendanceRecords    AttendanceRecord[]
  parentNotifications  ParentNotification[]
}

model Staff {
  id          Int       @id @default(autoincrement())
  firstName   String
  lastName    String
  email       String    @unique
  password    String
  phoneNumber String
  role        StaffRole @default(DISCIPLINE)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

enum StaffRole {
  ADMIN
  DISCIPLINE
  NURSE
  LIBRARIAN
}

model DisciplineRecord {
  id            Int       @id @default(autoincrement())
  studentId     Int
  reason        String
  location      String?
  status        String    @default("OUT")
  outDate       DateTime  @default(now())
  returnDate    DateTime?
  accompaniedBy String? // Name of staff member going with the student (School Event)
  eventTheme    String? // Theme of the event (School Event)
  updatedAt     DateTime  @updatedAt
  student       Student   @relation(fields: [studentId], references: [id])
}

model Transport {
  id          Int                   @id @default(autoincrement())
  location    String
  price       Float
  assignments TransportAssignment[]
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
}

model TransportAssignment {
  id          Int             @id @default(autoincrement())
  studentId   Int
  transportId Int
  status      TransportStatus @default(NOT_PAID)
  student     Student         @relation(fields: [studentId], references: [id])
  transport   Transport       @relation(fields: [transportId], references: [id])
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([studentId, transportId])
}

enum TransportStatus {
  PAID
  NOT_PAID
  OUT
}

enum Status {
  IN
  OUT
  RETURNED
}

model AcademicTerm {
  id        Int       @id @default(autoincrement())
  name      String
  startDate DateTime
  endDate   DateTime?
  isActive  Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  attendanceRecords AttendanceRecord[]
}

model AttendanceRecord {
  id              Int              @id @default(autoincrement())
  studentId       Int
  termId          Int
  date            DateTime         @db.Date
  status          AttendanceStatus @default(PRESENT)
  note            String?
  markedByStaffId Int?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  student Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  term    AcademicTerm @relation(fields: [termId], references: [id], onDelete: Cascade)

  @@unique([studentId, termId, date])
}

model ParentNotification {
  id        Int                    @id @default(autoincrement())
  studentId Int
  channel   String                 @default("SMS")
  phone     String
  message   String
  type      ParentNotificationType
  status    NotificationStatus     @default(SENT)
  sentAt    DateTime               @default(now())
  createdAt DateTime               @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum ParentNotificationType {
  TERM_OPENING
  ABSENCE_ALERT
  ATTENDANCE_SUMMARY
}

enum NotificationStatus {
  SENT
  FAILED
  PENDING
}
