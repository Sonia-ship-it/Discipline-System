generator client {
  provider = "prisma-client-js"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

model Student {
  id                Int                @id @default(autoincrement())
  firstName         String
  lastName          String
  fatherName        String
  motherName        String
  fatherPhoneNumber String
  motherPhoneNumber String

  year              String
  classGroup        String

  location          String?   // transport location

  status            Status @default(IN)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  records           DisciplineRecord[]
  transportAssignments TransportAssignment[]
  phoneBorrows      PhoneBorrow[]
  termAttendances   TermAttendance[]
}


model Staff {
  id          Int      @id @default(autoincrement())
  firstName   String
  lastName    String
  email       String   @unique
  password    String
  phoneNumber String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  termAttendances TermAttendance[]
}

model DisciplineRecord {
  id         Int       @id @default(autoincrement())
  studentId  Int
  reason     String
  location   String?
  status     String    @default("OUT")
  outDate    DateTime  @default(now())
  returnDate DateTime?
  updatedAt  DateTime  @updatedAt
  student    Student   @relation(fields: [studentId], references: [id])
}

model Transport {
  id          Int       @id @default(autoincrement())
  location    String    
  price       Float     
  assignments TransportAssignment[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model TransportAssignment {
  id          Int             @id @default(autoincrement())
  studentId   Int
  transportId Int
  status      TransportStatus @default(NOT_PAID)
  student     Student         @relation(fields: [studentId], references: [id])
  transport   Transport       @relation(fields: [transportId], references: [id])
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([studentId, transportId])
}

enum TransportStatus {
  PAID
  NOT_PAID
  OUT
}

enum Status {
  IN
  OUT
  RETURNED
}

model PhoneBorrow {
  id          Int               @id @default(autoincrement())
  studentId   Int
  phoneModel  String            @default("Mara Z")
  borrowedAt  DateTime          @default(now())
  returnedAt  DateTime?
  status      PhoneBorrowStatus @default(BORROWED)
  student     Student           @relation(fields: [studentId], references: [id])
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

enum PhoneBorrowStatus {
  BORROWED
  RETURNED
}

model TermSession {
  id          Int              @id @default(autoincrement())
  name        String           // "Term 1", "Term 2", "Term 3"
  year        Int
  startDate   DateTime
  endDate     DateTime
  openingDate DateTime
  isActive    Boolean          @default(false)
  status      TermStatus       @default(UPCOMING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  attendances TermAttendance[]

  @@unique([name, year])
}

model TermAttendance {
  id           Int         @id @default(autoincrement())
  termId       Int
  studentId    Int
  status       AttendanceStatus @default(NOT_REPORTED)
  arrivalTime  DateTime?
  recordedById Int?
  recordedBy   Staff?      @relation(fields: [recordedById], references: [id])
  student      Student     @relation(fields: [studentId], references: [id])
  term         TermSession @relation(fields: [termId], references: [id])
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([termId, studentId])
}

enum AttendanceStatus {
  REPORTED
  NOT_REPORTED
}

enum TermStatus {
  UPCOMING
  ACTIVE
  COMPLETED
}
