DATABASE_URL=postgresql://user:password@localhost:5432/rca_dms
DIRECT_URL=postgresql://user:password@localhost:5432/rca_dms
# For Supabase/cloud: leave unset (SSL enabled, cert chain relaxed for dev)
# For local Postgres without SSL: DATABASE_SSL=false
# Force SSL: DATABASE_SSL=require
DATABASE_SSL=
JWT_SECRET=change-me-to-a-long-random-string
PORT=2008

# Optional: real SMS delivery for parent notifications
# SMS_WEBHOOK_URL=https://your-sms-provider/webhook
